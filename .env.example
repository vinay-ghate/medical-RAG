# LLM Configuration (Groq is free at https://console.groq.com)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings (Runs locally & free via sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Reranker (Runs locally & free via FlashRank)
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2

# Vector Store (Local Chroma DB)
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Retrieval Settings
RETRIEVAL_TOP_K=10
RERANK_TOP_K=4
BM25_WEIGHT=0.4
DENSE_WEIGHT=0.6

# LangSmith Observability (Optional Free Tier at https://smith.langchain.com)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=medical-rag
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
